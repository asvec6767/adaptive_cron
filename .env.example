# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=cron_user
DB_PASSWORD=cron_pass
DB_NAME=adaptive_cron

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Service Ports
API_GATEWAY_PORT=8080
TASK_MANAGER_PORT=8081
SCHEDULER_PORT=8082
METRIC_AGENT_PORT=8083
WORKER_PORT=8084

# Service URLs
TASK_MANAGER_URL=http://localhost:8081
SCHEDULER_URL=http://localhost:8082
METRIC_AGENT_URL=http://localhost:8083
WORKER_URL=http://localhost:8084

# Scheduler
CHECK_INTERVAL=10s
DELAYED_QUEUE_CHECK=5s

# Worker
MAX_CONCURRENT_JOBS=5

# Metric Agent
COLLECT_INTERVAL=5s
MAX_HISTORY_SIZE=1000

# Logging
LOG_LEVEL=info
LOG_FORMAT=text